{
  "name": "tidefall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "start": "tsx server.ts --production",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test --test-concurrency=2 tests/*.test.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.186.1",
    "ws": "8.22.0",
    "tsx": "^4.20.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.0"
  }
}
